# Copy to `.env` and fill in. Vite bakes VITE_* values into the bundle at build time.

# Password gate. Set VITE_DISABLE_AUTH=true to skip it (e.g. local development).
VITE_DISABLE_AUTH=true
VITE_APP_PASSWORD=

# Firebase Realtime Database (only needed for multi-device mode).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
